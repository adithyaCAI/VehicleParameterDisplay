# IAR Embedded Workbench for Arm toolchain file (generated by FirmGen).
# Selected with -DCMAKE_TOOLCHAIN_FILE=cmake/iar-arm.cmake when the project's compiler is IAR.
# CMake's own IAR support finds the linker (ilinkarm) and ielftool next to the compiler.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(FIRMGEN_IAR_BIN "${FIRMGEN_IAR_BIN}" CACHE PATH "IAR arm/bin directory (empty: iccarm on PATH)")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES FIRMGEN_IAR_BIN)
if(CMAKE_HOST_WIN32)
  set(_FG_EXE ".exe")
else()
  set(_FG_EXE "")
endif()
if(FIRMGEN_IAR_BIN)
  set(CMAKE_C_COMPILER   "${FIRMGEN_IAR_BIN}/iccarm${_FG_EXE}")
  set(CMAKE_ASM_COMPILER "${FIRMGEN_IAR_BIN}/iasmarm${_FG_EXE}")
else()
  set(CMAKE_C_COMPILER   iccarm)
  set(CMAKE_ASM_COMPILER iasmarm)
endif()
# Don't try to LINK during the compiler check (no startup/linker configuration yet).
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# Core/FPU from the MCU family.
set(CMAKE_C_FLAGS_INIT   "--cpu=Cortex-M0+")
set(CMAKE_ASM_FLAGS_INIT "--cpu Cortex-M0+")
